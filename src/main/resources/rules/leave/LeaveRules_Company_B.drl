    when
        $emp    : EmployeeFact(companyId == "COMPANY_B",
                               seniorityMonths >= 60, seniorityMonths < 120)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() <= 16)
