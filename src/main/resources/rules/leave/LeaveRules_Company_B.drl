    when
        $emp    : EmployeeFact(companyId == "COMPANY_B",
                               seniorityMonths >= 6, seniorityMonths < 12)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() <= 4)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 4 - $leave.getUsedDaysThisYear() - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Annual Leave 6 Months - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("[CompanyB] Annual leave (6 months): full pay, 4 days entitlement.");
        update($result);
end

