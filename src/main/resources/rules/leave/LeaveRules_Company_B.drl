package rules.leave

import com.function.model.EmployeeFact
import com.function.model.LeaveFact
import com.function.model.LeaveResult
import java.math.BigDecimal

// ============================================================
// COMPANY_B OVERRIDES
// - Marriage Leave  : 10 days (enhanced)
// - Personal Leave  : 14 days (same as Labour Standards Act)
// - Annual Leave    : +1 day bonus on every tier
// - Family Care     : 7 days (same as Labour Standards Act)
// - Birthday Leave  : 2 days full pay
// ============================================================

// ── Marriage Leave ────────────────────────────────────────

rule "Marriage Leave - Exceeds Limit - CompanyB"
    salience 20
    when
        $emp    : EmployeeFact(companyId == "COMPANY_B")
        $leave  : LeaveFact(leaveTypeName == "MARRIAGE",
                            usedDaysThisYear + leaveDays.intValue() > 10)
        $result : LeaveResult(appliedRule == null)
    then
        int remaining = 10 - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Marriage Leave - Exceeds Limit");
        $result.setMessage("[CompanyB] Marriage leave limit is 10 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Marriage Leave - Approved - CompanyB"
    salience 15
    when
        $emp    : EmployeeFact(companyId == "COMPANY_B")
        $leave  : LeaveFact(leaveTypeName == "MARRIAGE",
                            usedDaysThisYear + leaveDays.intValue() <= 10)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 10 - $leave.getUsedDaysThisYear() - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Marriage Leave - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("[CompanyB] Marriage leave: full pay for " + $leave.getLeaveDays() + " day(s), 10-day enhanced policy.");
        update($result);
end

