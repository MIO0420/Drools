// ── Annual Leave (+1 day bonus on every tier) ─────────────

rule "Annual Leave 6 Months - Exceeds Limit - CompanyB"
    salience 20
    when
        $emp    : EmployeeFact(companyId == "COMPANY_B",
                               seniorityMonths >= 6, seniorityMonths < 12)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() > 4)
        $result : LeaveResult(appliedRule == null)
    then
        int remaining = 4 - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Annual Leave 6 Months - Exceeds Limit");
        $result.setMessage("[CompanyB] Annual leave (6 months) limit is 4 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Annual Leave 6 Months - Approved - CompanyB"
