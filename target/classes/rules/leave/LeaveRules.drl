        $result.setMessage("Annual leave (5-10 years) limit is 15 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Annual Leave 5 to 10 Years - Approved - Base"
    salience 5
    when
        $emp    : EmployeeFact(seniorityMonths >= 60, seniorityMonths < 120)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() <= 15)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
