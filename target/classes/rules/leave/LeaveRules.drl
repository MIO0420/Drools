rule "Paternity Leave - Approved"
    salience 5
    when
        $emp    : EmployeeFact()
        $leave  : LeaveFact(leaveTypeName == "PATERNITY",
                            usedDaysThisYear + leaveDays.intValue() <= 7)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 7 - $leave.getUsedDaysThisYear() - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Paternity Leave - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Paternity leave: full pay, 7 days. No deduction from perfect attendance bonus.");
        update($result);
end

// ============================================================
// MATERNITY LEAVE (all companies follow Labour Standards Act)
// ============================================================

rule "Maternity Leave - Exceeds Limit"
    salience 10
    when
        $leave  : LeaveFact(leaveTypeName == "MATERNITY", leaveDays.intValue() > 56)
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Maternity Leave - Exceeds Limit");
        $result.setMessage("Maternity leave limit is 56 days. Application exceeds the legal limit.");
        update($result);
end

rule "Maternity Leave Full Pay - Approved"
    salience 5
    when
        $emp    : EmployeeFact(seniorityMonths >= 6)
        $leave  : LeaveFact(leaveTypeName == "MATERNITY", leaveDays.intValue() <= 56)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 56 - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Maternity Leave Full Pay - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Maternity leave (seniority >= 6 months): full pay, 8 weeks.");
        update($result);
end

rule "Maternity Leave Half Pay - Approved"
    salience 5
    when
        $emp    : EmployeeFact(seniorityMonths < 6)
        $leave  : LeaveFact(leaveTypeName == "MATERNITY", leaveDays.intValue() <= 56)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 56 - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Maternity Leave Half Pay - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Maternity leave (seniority < 6 months): half pay.");
        update($result);
end

rule "Maternity Leave Full Pay With Public Holiday - Senior Manager"
    salience 8
    when
        $emp    : EmployeeFact(
                    seniorityMonths > 60,
                    position != null,
                    position in ("MANAGER", "DIRECTOR", "VP", "C_LEVEL")
                  )
        $leave  : LeaveFact(
                    leaveTypeName == "MATERNITY",
                    leaveDays.intValue() <= 56,
                    publicHolidayDays > 0
                  )
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int effectiveDays = $leave.getLeaveDays().intValue() - $leave.getPublicHolidayDays();
        int remaining     = 56 - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Maternity Leave Full Pay With Public Holiday - Senior Manager");
        $result.setAffectFullAttendance(false);
        $result.setMessage(
            "Maternity leave (seniority > 5 years, manager+): full pay. " +
            "Public holidays (" + $leave.getPublicHolidayDays() + " day(s)) excluded. " +
            "Effective leave days: " + effectiveDays + ". Remaining: " + remaining + " day(s)."
        );
        update($result);
end

