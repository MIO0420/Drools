// ============================================================
// BIRTHDAY LEAVE - BASE
// ============================================================

rule "Birthday Leave - Not Applicable - Base"
    salience 5
    when
        $emp    : EmployeeFact(companyId not in ("COMPANY_A", "COMPANY_B", "COMPANY_C"))
        $leave  : LeaveFact(leaveTypeName == "BIRTHDAY")
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Birthday Leave - Not Applicable");
        $result.setMessage("[" + $emp.getCompanyId() + "] Birthday leave is not part of this company's policy.");
        update($result);
end
