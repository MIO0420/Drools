        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Prenatal Checkup Leave - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Prenatal checkup leave: full pay for " + $leave.getLeaveDays() + " day(s).");
