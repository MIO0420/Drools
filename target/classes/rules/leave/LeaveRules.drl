// ============================================================
// PARENTAL LEAVE
// ============================================================

rule "Parental Leave - Seniority Not Met"
    salience 10
    when
        $emp    : EmployeeFact(seniorityMonths < 6)
        $leave  : LeaveFact(leaveTypeName == "PARENTAL")
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Parental Leave - Seniority Not Met");
        $result.setMessage("Parental leave requires at least 6 months of seniority.");
        update($result);
end

rule "Parental Leave - Exceeds Limit"
    salience 10
    when
        $emp    : EmployeeFact(seniorityMonths >= 6)
        $leave  : LeaveFact(leaveTypeName == "PARENTAL", leaveDays.intValue() > 730)
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Parental Leave - Exceeds Limit");
        $result.setMessage("Parental leave limit is 730 days (24 months).");
        update($result);
end

rule "Parental Leave - Approved"
    salience 5
    when
        $emp    : EmployeeFact(seniorityMonths >= 6)
        $leave  : LeaveFact(leaveTypeName == "PARENTAL", leaveDays.intValue() <= 730)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(730 - $leave.getLeaveDays().intValue());
        $result.setAppliedRule("Parental Leave - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Parental leave: unpaid, max 730 days.");
        update($result);
end

