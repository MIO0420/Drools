        $result.setAffectFullAttendance(false);
        $result.setMessage("Annual leave (10+ years): full pay, " + entitled + " days entitlement.");
        update($result);
end

// ============================================================
// MENSTRUAL LEAVE (all companies follow Labour Standards Act)
// ============================================================

rule "Menstrual Leave - Exceeds Annual Limit"
    salience 10
    when
        $leave  : LeaveFact(leaveTypeName == "MENSTRUAL", usedDaysThisYear >= 12)
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Menstrual Leave - Exceeds Annual Limit");
        $result.setMessage("Menstrual leave annual limit of 12 days has been exhausted.");
        update($result);
end

rule "Menstrual Leave - Exceeds Daily Limit"
    salience 10
    when
        $leave  : LeaveFact(leaveTypeName == "MENSTRUAL", leaveDays.intValue() > 1)
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Menstrual Leave - Exceeds Daily Limit");
        $result.setMessage("Menstrual leave is limited to 1 day per request.");
        update($result);
end

rule "Menstrual Leave Within 3 Days Per Year - Approved"
    salience 5
    when
        $emp    : EmployeeFact()
        $leave  : LeaveFact(leaveTypeName == "MENSTRUAL",
                            usedDaysThisYear < 3, leaveDays.intValue() == 1)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 12 - $leave.getUsedDaysThisYear() - 1;
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Menstrual Leave Within 3 Days Per Year - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Menstrual leave (first 3 days/year): half pay. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Menstrual Leave Over 3 Days Per Year - Approved"
    salience 5
    when
        $emp    : EmployeeFact()
        $leave  : LeaveFact(leaveTypeName == "MENSTRUAL",
                            usedDaysThisYear >= 3, usedDaysThisYear < 12,
                            leaveDays.intValue() == 1)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 12 - $leave.getUsedDaysThisYear() - 1;
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Menstrual Leave Over 3 Days Per Year - Approved");
        $result.setAffectFullAttendance(true);
        $result.setMessage("Menstrual leave (from 4th day/year): half pay, counted toward sick leave. Remaining: " + remaining + " day(s).");
        update($result);
end

