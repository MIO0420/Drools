// ============================================================
// PRENATAL CHECKUP LEAVE
// ============================================================

rule "Prenatal Checkup Leave - Exceeds Limit"
    salience 10
    when
        $leave  : LeaveFact(leaveTypeName == "PRENATAL_CHECKUP",
                            usedDaysThisYear + leaveDays.intValue() > 7)
        $result : LeaveResult(appliedRule == null)
    then
        int remaining = 7 - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Prenatal Checkup Leave - Exceeds Limit");
        $result.setMessage("Prenatal checkup leave limit is 7 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Prenatal Checkup Leave - Approved"
    salience 5
