// ============================================================
// ANNUAL LEAVE - BASE (Labour Standards Act tiers)
// ============================================================

rule "Annual Leave 6 Months - Exceeds Limit - Base"
    salience 10
    when
        $emp    : EmployeeFact(seniorityMonths >= 6, seniorityMonths < 12)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() > 3)
        $result : LeaveResult(appliedRule == null)
    then
        int remaining = 3 - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Annual Leave 6 Months - Exceeds Limit");
        $result.setMessage("Annual leave (6 months) limit is 3 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Annual Leave 6 Months - Approved - Base"
    salience 5
    when
        $emp    : EmployeeFact(seniorityMonths >= 6, seniorityMonths < 12)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() <= 3)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 3 - $leave.getUsedDaysThisYear() - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Annual Leave 6 Months - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Annual leave (6 months): full pay, 3 days entitlement.");
        update($result);
end

