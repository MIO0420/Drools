package rules.leave

import com.function.model.EmployeeFact
import com.function.model.LeaveFact
import com.function.model.LeaveResult
import java.math.BigDecimal
import java.math.RoundingMode

// ============================================================
// MARRIAGE LEAVE - BASE (Labour Standards Act: max 8 days)
// ============================================================

rule "Marriage Leave - Exceeds Limit - Base"
    salience 10
    when
        $leave  : LeaveFact(leaveTypeName == "MARRIAGE",
                            usedDaysThisYear + leaveDays.intValue() > 8)
        $result : LeaveResult(appliedRule == null)
    then
        int remaining = 8 - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Marriage Leave - Exceeds Limit");
        $result.setMessage("Marriage leave limit is 8 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Marriage Leave - Approved - Base"
    salience 5
    when
        $leave  : LeaveFact(leaveTypeName == "MARRIAGE",
                            usedDaysThisYear + leaveDays.intValue() <= 8)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 8 - $leave.getUsedDaysThisYear() - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Marriage Leave - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Marriage leave: full pay for " + $leave.getLeaveDays() + " day(s). No deduction from perfect attendance bonus.");
        update($result);
end

// ============================================================
// BEREAVEMENT LEAVE (all companies follow Labour Standards Act)
// ============================================================

rule "Bereavement Leave - Spouse or Parents - Exceeds Limit"
    salience 10
    when
        $leave  : LeaveFact(leaveTypeName == "BEREAVEMENT",
                            bereavementRelation in ("SPOUSE","PARENT","STEP_PARENT","ADOPTIVE_PARENT"),
                            leaveDays.intValue() > 8)
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Bereavement Leave - Spouse or Parents - Exceeds Limit");
        $result.setMessage("Bereavement leave (spouse/parents) limit is 8 days. Application exceeds the legal limit.");
        update($result);
end

rule "Bereavement Leave - Spouse or Parents - Approved"
    salience 5
    when
        $emp    : EmployeeFact()
        $leave  : LeaveFact(leaveTypeName == "BEREAVEMENT",
                            bereavementRelation in ("SPOUSE","PARENT","STEP_PARENT","ADOPTIVE_PARENT"),
                            leaveDays.intValue() <= 8)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Bereavement Leave - Spouse or Parents - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("Bereavement leave (spouse/parents): full pay for " + $leave.getLeaveDays() + " day(s).");
        update($result);
end

