        $result.setAppliedRule("Personal Leave - Approved");
        $result.setAffectFullAttendance(true);
        $result.setMessage("[CompanyC] Personal leave: first 3 days full pay, rest unpaid. Remaining: " + remaining + " day(s).");
        update($result);
end

// ── Annual Leave (same tiers as base, explicit for CompanyC) ──

rule "Annual Leave 6 Months - Exceeds Limit - CompanyC"
    salience 20
    when
        $emp    : EmployeeFact(companyId == "COMPANY_C",
                               seniorityMonths >= 6, seniorityMonths < 12)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() > 3)
        $result : LeaveResult(appliedRule == null)
    then
        int remaining = 3 - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Annual Leave 6 Months - Exceeds Limit");
        $result.setMessage("[CompanyC] Annual leave (6 months) limit is 3 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Annual Leave 6 Months - Approved - CompanyC"
    salience 15
    when
        $emp    : EmployeeFact(companyId == "COMPANY_C",
                               seniorityMonths >= 6, seniorityMonths < 12)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            usedDaysThisYear + leaveDays.intValue() <= 3)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 3 - $leave.getUsedDaysThisYear() - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Annual Leave 6 Months - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("[CompanyC] Annual leave (6 months): full pay, 3 days entitlement.");
        update($result);
end

