// ── Birthday Leave (1 day full pay) ───────────────────────

rule "Birthday Leave - Approved - CompanyC"
    salience 20
    when
        $emp    : EmployeeFact(companyId == "COMPANY_C")
        $leave  : LeaveFact(leaveTypeName == "BIRTHDAY")
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(true);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(-1);
        $result.setAppliedRule("Birthday Leave - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("[CompanyC] Birthday leave: full pay, 1 day. No deduction from perfect attendance bonus.");
        update($result);
end
