        update($result);
end

rule "Personal Leave - Approved - CompanyC"
    salience 15
    when
        $emp    : EmployeeFact(companyId == "COMPANY_C")
        $leave  : LeaveFact(leaveTypeName == "PERSONAL",
                            usedDaysThisYear + leaveDays.intValue() <= 17)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
