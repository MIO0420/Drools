rule "Annual Leave Over 10 Years - Exceeds Limit - CompanyC"
    salience 20
    when
        $emp    : EmployeeFact(companyId == "COMPANY_C", seniorityMonths >= 120)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            eval($leave.getUsedDaysThisYear() + $leave.getLeaveDays().intValue()
                                 > Math.min(15 + (int)($emp.getSeniorityMonths()/12.0) - 10, 30)))
        $result : LeaveResult(appliedRule == null)
    then
        int entitled  = (int) Math.min(15 + (int)($emp.getSeniorityMonths()/12.0) - 10, 30);
        int remaining = entitled - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Annual Leave Over 10 Years - Exceeds Limit");
        $result.setMessage("[CompanyC] Annual leave (10+ years) limit is " + entitled + " days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Annual Leave Over 10 Years - Approved - CompanyC"
    salience 15
    when
        $emp    : EmployeeFact(companyId == "COMPANY_C", seniorityMonths >= 120)
        $leave  : LeaveFact(leaveTypeName == "ANNUAL",
                            eval($leave.getUsedDaysThisYear() + $leave.getLeaveDays().intValue()
                                 <= Math.min(15 + (int)($emp.getSeniorityMonths()/12.0) - 10, 30)))
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int entitled  = (int) Math.min(15 + (int)($emp.getSeniorityMonths()/12.0) - 10, 30);
