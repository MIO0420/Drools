// ── Birthday Leave (NOT applicable for CompanyA) ──────────

rule "Birthday Leave - Not Applicable - CompanyA"
    salience 20
    when
        $emp    : EmployeeFact(companyId == "COMPANY_A")
        $leave  : LeaveFact(leaveTypeName == "BIRTHDAY")
        $result : LeaveResult(appliedRule == null)
    then
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(0);
        $result.setAppliedRule("Birthday Leave - Not Applicable");
        $result.setMessage("[CompanyA] Birthday leave is not part of this company's policy.");
        update($result);
end
