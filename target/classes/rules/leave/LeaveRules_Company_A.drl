package rules.leave

import com.function.model.EmployeeFact
import com.function.model.LeaveFact
import com.function.model.LeaveResult
import java.math.BigDecimal

// ============================================================
// COMPANY_A OVERRIDES
// - Marriage Leave  : 8 days (same as Labour Standards Act, explicit)
// - Personal Leave  : 14 days (same as Labour Standards Act, explicit)
// - Annual Leave    : Labour Standards Act tiers (same as base)
// - Family Care     : 7 days (same as Labour Standards Act, explicit)
// - Birthday Leave  : NOT applicable
// ============================================================

// ── Marriage Leave ────────────────────────────────────────

rule "Marriage Leave - Exceeds Limit - CompanyA"
    salience 20
    when
        $emp    : EmployeeFact(companyId == "COMPANY_A")
        $leave  : LeaveFact(leaveTypeName == "MARRIAGE",
                            usedDaysThisYear + leaveDays.intValue() > 8)
        $result : LeaveResult(appliedRule == null)
    then
        int remaining = 8 - $leave.getUsedDaysThisYear();
        $result.setApproved(false);
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining < 0 ? 0 : remaining);
        $result.setAppliedRule("Marriage Leave - Exceeds Limit");
        $result.setMessage("[CompanyA] Marriage leave limit is 8 days. Remaining: " + remaining + " day(s).");
        update($result);
end

rule "Marriage Leave - Approved - CompanyA"
    salience 15
    when
        $emp    : EmployeeFact(companyId == "COMPANY_A")
        $leave  : LeaveFact(leaveTypeName == "MARRIAGE",
                            usedDaysThisYear + leaveDays.intValue() <= 8)
        $result : LeaveResult(approved == true, appliedRule == null)
    then
        int remaining = 8 - $leave.getUsedDaysThisYear() - $leave.getLeaveDays().intValue();
        $result.setDeductAmount(BigDecimal.ZERO);
        $result.setRemainingDays(remaining);
        $result.setAppliedRule("Marriage Leave - Approved");
        $result.setAffectFullAttendance(false);
        $result.setMessage("[CompanyA] Marriage leave: full pay for " + $leave.getLeaveDays() + " day(s). No deduction from perfect attendance bonus.");
        update($result);
end

