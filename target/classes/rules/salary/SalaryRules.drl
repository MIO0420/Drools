// ============================================================
// BLOCK 2：加班費計算（計算邏輯全部委託 RuleUtils）
// ============================================================

// 平日加班（RuleUtils 內部自動處理 ≤2H / >2H 兩段）
rule "Overtime - Weekday"
    salience 100
    when
        $emp    : EmployeeFact()
        $ot     : OvertimeFact(overtimeType == "WEEKDAY", overtimeHours > 0)
        $result : SalaryResult()
    then
        BigDecimal bonus = calcWeekdayOvertime($emp.getBaseSalary(), $ot.getOvertimeHours());
        $result.setOvertimeBonus($result.getOvertimeBonus().add(bonus));
        $result.addRuleDetail("【加班費】平日加班 " + $ot.getOvertimeHours() + "H，加給 +" + bonus);
end

// 休息日加班（RuleUtils 內部自動處理三段式倍率）
rule "Overtime - Rest Day"
    salience 100
    when
        $emp    : EmployeeFact()
        $ot     : OvertimeFact(overtimeType == "REST_DAY", overtimeHours > 0)
        $result : SalaryResult()
    then
        BigDecimal bonus = calcRestDayOvertime($emp.getBaseSalary(), $ot.getOvertimeHours());
        $result.setOvertimeBonus($result.getOvertimeBonus().add(bonus));
        $result.addRuleDetail("【加班費】休息日加班 " + $ot.getOvertimeHours() + "H，加給 +" + bonus);
end

// 國定假日出勤（RuleUtils 內部自動處理 ≤8H / >8H）
rule "Overtime - National Holiday"
    salience 100
    when
        $emp    : EmployeeFact()
        $ot     : OvertimeFact(overtimeType == "NATIONAL_HOLIDAY", overtimeHours > 0)
        $result : SalaryResult()
    then
        BigDecimal bonus = calcNationalHolidayOvertime($emp.getBaseSalary(), $ot.getOvertimeHours());
        $result.setOvertimeBonus($result.getOvertimeBonus().add(bonus));
        $result.addRuleDetail("【加班費】國定假日出勤 " + $ot.getOvertimeHours() + "H，加給 +" + bonus);
end

// 例假日出勤（RuleUtils 內部自動處理 ≤8H / >8H）
rule "Overtime - Statutory Holiday"
    salience 100
    when
        $emp    : EmployeeFact()
        $ot     : OvertimeFact(overtimeType == "STATUTORY_HOLIDAY", overtimeHours > 0)
        $result : SalaryResult()
    then
        BigDecimal bonus = calcStatutoryHolidayOvertime($emp.getBaseSalary(), $ot.getOvertimeHours());
        $result.setOvertimeBonus($result.getOvertimeBonus().add(bonus));
        $result.addRuleDetail("【加班費】例假日出勤 " + $ot.getOvertimeHours() + "H，加給 +" + bonus);
end

// 特休出勤（與例假日同費率）
rule "Overtime - Annual Leave Day"
    salience 100
    when
        $emp    : EmployeeFact()
        $ot     : OvertimeFact(overtimeType == "ANNUAL_LEAVE_DAY", overtimeHours > 0)
        $result : SalaryResult()
    then
        BigDecimal bonus = calcStatutoryHolidayOvertime($emp.getBaseSalary(), $ot.getOvertimeHours());
        $result.setOvertimeBonus($result.getOvertimeBonus().add(bonus));
        $result.addRuleDetail("【加班費】特休出勤 " + $ot.getOvertimeHours() + "H，加給 +" + bonus);
end

// ============================================================
// BLOCK 3：全勤獎金保障規則（salience 200）
// ============================================================

// 1. 婚假不得扣全勤獎金
rule "FullAttendance - 婚假不得扣全勤獎金"
    salience 200
    when
        $leave  : LeaveFact(leaveTypeName == "婚假", leaveHours > 0)
        $result : SalaryResult()
    then
        $result.setFullAttendancePenaltyExempt(true);
        $result.addRuleDetail("【全勤保障】婚假：雇主不得扣發全勤獎金（勞工請假規則第 2 條）");
end

