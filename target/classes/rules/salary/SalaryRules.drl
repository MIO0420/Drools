// ============================================================
// BLOCK 4：薪資結算彙總
// ============================================================

rule "Salary - Calculate Final Salary"
    salience 10
    when
        $emp    : EmployeeFact()
        $result : SalaryResult()
    then
        BigDecimal finalSalary = $emp.getBaseSalary()
            .subtract($result.getLeaveDeduction())
            .add($result.getOvertimeBonus())
            .setScale(2, RoundingMode.HALF_UP);
        $result.setFinalSalary(finalSalary);
        $result.setAppliedRule("Salary - Calculate Final Salary");
        $result.addRuleDetail("【結算】底薪 " + $emp.getBaseSalary()
            + " - 請假扣 " + $result.getLeaveDeduction()
            + " + 加班費 " + $result.getOvertimeBonus()
            + " = 實領 " + finalSalary);
        $result.setMessage("【員工實領明細】 底薪：" + $emp.getBaseSalary() +
                           " ｜請假扣：-" + $result.getLeaveDeduction() +
                           " ｜加班費：+" + $result.getOvertimeBonus() +
                           " ｜實領薪資：" + finalSalary);
end
