import static com.function.util.RuleUtils.calcNationalHolidayOvertime
import static com.function.util.RuleUtils.calcStatutoryHolidayOvertime

// 優先級定義：200 (全勤保障) -> 100 (計算) -> 10 (結算)

// ============================================================
// BLOCK 1：請假扣薪計算（計算邏輯全部委託 RuleUtils）
// ============================================================

// ── 100% 扣薪假別 ──────────────────────────────────────────

// 1. 事假 (100% 扣薪)
rule "Leave Deduction - 事假"
    salience 100
    when
        $emp    : EmployeeFact()
        $leave  : LeaveFact(leaveTypeName == "事假", leaveHours > 0)
        $result : SalaryResult()
    then
        BigDecimal deduct = calcLeaveDeduction($emp.getBaseSalary(), $leave.getLeaveHours(), "1.0");
        $result.setLeaveDeduction($result.getLeaveDeduction().add(deduct));
        $result.addRuleDetail("【請假扣薪】事假 " + $leave.getLeaveHours() + " 小時（100%扣薪），扣薪 -" + deduct);
end

