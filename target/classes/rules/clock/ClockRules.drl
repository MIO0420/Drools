// 路徑：Graduate/src/main/resources/rules/clock/ClockRules.drl
package rules.clock

import com.function.model.ClockFact
import com.function.model.ClockResult

// ════════════════════════════════════════════════════════════════
//  COMP_A：圍欄半徑 100 m
// ════════════════════════════════════════════════════════════════

rule "COMP_A - Location Out of Range"
    when
        $clock  : ClockFact(companyId == "COMP_A",
                            distanceToCompany != null,
                            distanceToCompany.doubleValue() > 100)
        $result : ClockResult()
    then
        $result.addViolation(
            "Clock - Location Out of Range",
            "[Geo-Fence Violation] Clock location is "
                + $clock.getDistanceToCompany().setScale(2, java.math.RoundingMode.HALF_UP)
                + " m from the office, exceeding the allowed radius of 100 m."
        );
end

rule "COMP_A - Clock-In Location Valid"
    when
        $clock  : ClockFact(companyId == "COMP_A",
                            recordType == "clock_in",
                            distanceToCompany != null,
                            distanceToCompany.doubleValue() <= 100)
        $result : ClockResult()
    then
        $result.addNote(
            "[Clock-In OK] Location verified. Distance to office: "
                + $clock.getDistanceToCompany().setScale(2, java.math.RoundingMode.HALF_UP)
                + " m."
        );
end

rule "COMP_A - Clock-Out Location Valid"
    when
        $clock  : ClockFact(companyId == "COMP_A",
                            recordType == "clock_out",
                            distanceToCompany != null,
                            distanceToCompany.doubleValue() <= 100)
        $result : ClockResult()
    then
        $result.addNote(
            "[Clock-Out OK] Location verified. Distance to office: "
                + $clock.getDistanceToCompany().setScale(2, java.math.RoundingMode.HALF_UP)
                + " m."
        );
end

