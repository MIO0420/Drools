// ════════════════════════════════════════════════════════════════
//  共用：缺少 GPS 座標
// ════════════════════════════════════════════════════════════════

rule "Clock - Missing Location"
    when
        $clock  : ClockFact(distanceToCompany == null)
        $result : ClockResult()
    then
        $result.addViolation(
            "Clock - Missing Location",
            "[Missing Location] No GPS coordinates provided. Geo-fence validation skipped."
        );
end
